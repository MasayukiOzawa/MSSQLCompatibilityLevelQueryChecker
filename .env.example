# Copy this file to .env only when your environment or launcher loads dotenv files.
# mssql-compat-check reads the named environment variable; it does not load .env files itself.
# TrustServerCertificate=true is intended for local development. Use certificate validation in production.
MSSQL_COMPAT_CONNECTION_STRING="Server=localhost;Database=ApplicationDb;Integrated Security=true;Encrypt=true;TrustServerCertificate=true"
