<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mssql-compat-check</AssemblyName>
    <RootNamespace>MssqlCompatCheck</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mssql-compat-check</ToolCommandName>
    <PackageId>MSSQLCompatibilityLevelQueryChecker.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>MSSQLCompatibilityLevelQueryChecker contributors</Authors>
    <Description>SQL Server compatibility-level query checker powered by SqlScriptDOM.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ScriptDomPackageVersion" Value="$(ScriptDomPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
